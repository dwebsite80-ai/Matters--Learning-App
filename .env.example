# GEMINI_API_KEY: Required for Gemini AI API calls.
# In Google AI Studio, configure this via Settings -> Secrets.
# In standalone environments, set this to your Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SUPABASE Configuration (Optional: connects to your Supabase project)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
